<?xml version="1.0" encoding="utf-8"?>
<!-- Server configs and subscription links never leave the phone: no cloud backup, no device-to-device copy.
     (They could not be decrypted elsewhere anyway: the key lives in this phone's Keystore.) -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
