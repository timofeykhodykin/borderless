/* The page that explains the system service (shown before macOS asks for the password). */
"setup.title" = "Border(less) needs a system service";
"setup.title.update" = "The system service needs an update";
"setup.lead" = "To pass the Mac's traffic through the tunnel, Border(less) installs a small service that runs in the background with administrator rights. macOS asks for your password once.";
"setup.lead.update" = "This version of Border(less) comes with a new service. macOS asks for your password again to replace it.";
"setup.why.title" = "Why a service";
"setup.why.text" = "macOS gives an app its own tunnel only through a network extension, which Apple allows only to apps in its paid developer program. This research project isn't in it, so a system service makes the tunnel — and routes and DNS can be changed only with administrator rights.";
"setup.does.title" = "What it does";
"setup.does.text" = "Creates the tunnel, sends traffic and DNS into it and checks the servers, also with the window closed. When the connection ends or after a failure, it puts the network settings back.";
"setup.doesnt.title" = "What it doesn't";
"setup.doesnt.text" = "Opens no ports to the network or to other apps, takes commands only from this copy of Border(less), checked by its signature, and keeps its data in a folder only the system can read.";
"setup.updates.title" = "Updates and removal";
"setup.updates.text" = "Each new version of the app replaces the service and asks for the password again. Settings → Remove the service takes it away.";
"setup.install" = "Install the service";
"setup.update" = "Update the service";
"setup.quit" = "Quit";
"setup.note" = "macOS may then show that a background item was added.";
"setup.waiting" = "Waiting for the service to start…";
